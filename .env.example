# Kopier til .env for lokal testing (aldri commit .env — den er i .gitignore).
# I GitHub Actions ligger disse som repo-secrets, ikke i denne filen.

# Doffin — krever utviklerkonto + subscription på
# https://dof-notices-prod-api.developer.azure-api.net
DOFFIN_SUBSCRIPTION_KEY=

# Anthropic — vurderingslaget (score_notices.py)
ANTHROPIC_API_KEY=

# Slack — Incoming Webhook URL for kanalen digesten skal til
SLACK_WEBHOOK_URL=

# E-post — SMTP for digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DIGEST_EMAIL_TO=

# Valgfritt
DIGEST_THRESHOLD=50
